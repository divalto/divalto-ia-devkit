  "tokens": [
    { "token": "<lng>KEY</lng>", "meaning": "translation lookup by key, embedded inside a <Texte> static string" },
    { "token": "<msk>EXPR</msk>", "meaning": "mask/expression token, embedded inside a <Texte> static string" },
    { "token": "%current_page%", "meaning": "current page number at print time" },
    { "token": "%total_pages%", "meaning": "total page count at print time" },
    {
      "token": "'lng:alias:column'",
      "meaning": "SELECT column alias convention that binds a translation key to a data column (seen in band requete SQL, e.g. \"cic.translationKey AS 'lng:country:countryLabel'\")"
    }
  ],
  "formats": {
    "FormatDate": ["d", "D", "dd/MM/yyyy"],
    "FormatNombre": ["@maskName (mask reference)", "0.00 (or other .NET numeric format string)"],
    "FormatText": ["free-form text format/mask, no fixed enum"],
    "Casse": ["None", "MAJUSCULE", "minuscule", "Phrase", "Mot"]
  },
  "etat": {
    "attrs": [
      "table",
      "margeLeft",
      "margeTop",
      "margeRight",
      "margeBottom",
      "format",
      "formatSpecifique",
      "customLargeur",
      "customHauteur",
      "onePageReport",
      "impressionViaPDF",
      "imageDPI"
    ],
    "children": ["Grille", "GlobalFont", "DefautParams"],
    "notes": [
      "format is one of A4, A3, A5, B5, Legal, Letter, Custom; customLargeur/customHauteur (mm) only apply when format=\"Custom\".",
      "Thermal-printer presets are stored as format=\"Custom\" + formatSpecifique=\"BLUEBAMBOO\"|\"IAPS\"|\"LINEAPRO\" with fixed customLargeur/customHauteur + margins (mm).",
      "table binds the report to its main entity (drives the %row_ID% token).",
      "Grille carries grilleLargeur/grilleHauteur (snap-to-grid size in points).",
      "GlobalFont carries fontFamily/size and is the report-wide default font.",
      "DefautParams is left lossless by the designer (round-tripped, not edited).",
      "onePageReport and impressionViaPDF are presence/\"true\" boolean attrs, omitted when false.",
      "imageDPI is a positive integer; omitted (not zero) when unset."
    ]
  },
  "dbProps": {
    "file": "{code}.json",
    "fields": [
      { "name": "label", "type": "string" },
      { "name": "reportType", "type": "string | null" },
      { "name": "isDefault", "type": "boolean" },
      { "name": "exportValue", "type": "number | null" },
      { "name": "externalDocCode", "type": "string | null" },
      { "name": "stub", "type": "string | null" },
      { "name": "archiveMode", "type": "number | null" },
      { "name": "archiveVersionsNumber", "type": "number | null" },
      { "name": "translationKey", "type": "string | null" }
    ]
  }
}
